vorzugter Anbieter für SEPA und BNB Smart Chain"></textarea>
              </div>
            </div>
            <div class="actions">
              <button class="button" id="saveExchange" type="button">Affiliate-Link speichern</button>
              <button class="button secondary hidden" id="cancelExchangeEdit" type="button">Bearbeitung abbrechen</button>
            </div>
          </div>
        </details>

        <div class="archive-head">
          <div><h3 style="margin:0">Affiliate-Archiv</h3><p class="helper">Alle Einträge bleiben ausschließlich im LocalStorage dieses Gerätes.</p></div>
