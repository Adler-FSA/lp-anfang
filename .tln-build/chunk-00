<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light">
  <title>TLN Projekt-Einstieg</title>
  <style>
    :root{--bg:#fff;--text:#121212;--muted:#62666d;--line:#dde1e6;--soft:#f7f8fa;--purple:#6b4eff;--purple-soft:#f0edff;--gold:#c99726;--gold-soft:#fff8e6;--green:#167c5a;--green-soft:#eaf7f2;--red:#b42318;--red-soft:#fff1f0;--max:1120px}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:Arial,Helvetica,sans-serif;line-height:1.65}a{color:inherit;text-underline-offset:3px}a,summary,button{-webkit-tap-highlight-color:transparent}
    .page{width:min(100% - 28px,var(--max));margin:0 auto;padding:28px 0 64px}.hero,.journey,.notice,.final{border:1px solid var(--line);background:#fff;margin-bottom:24px}.hero{padding:34px;border-left:7px solid var(--purple)}
    .eyebrow{display:inline-flex;align-items:center;gap:8px;padding:7px 11px;border-radius:999px;background:var(--purple-soft);color:var(--purple);font-size:.8rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase}.eyebrow svg{width:16px;height:16px}
    h1,h2,h3{margin-top:0;line-height:1.25}h1{font-size:clamp(2rem,5vw,3.4rem);margin:14px 0 12px}h2{font-size:clamp(1.45rem,3vw,2rem);margin-bottom:10px}h3{font-size:1.1rem;margin-bottom:8px}p{margin:0 0 14px}.lead{max-width:850px;color:var(--muted);font-size:1.08rem;margin:0}
    .notice{display:flex;gap:14px;align-items:flex-start;padding:18px 20px;background:var(--soft)}.notice svg{width:22px;height:22px;flex:0 0 auto;color:var(--purple);margin-top:2px}
    .map{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:24px 0}.map a{display:flex;flex-direction:column;gap:6px;padding:16px;border:1px solid var(--line);background:var(--soft);text-decoration:none}.map strong{color:var(--purple)}.map span{font-size:.9rem;color:var(--muted)}
    .journey{padding:28px;scroll-margin-top:14px}.journey-head{display:flex;gap:16px;align-items:flex-start;margin-bottom:20px}.journey-number{display:grid;place-items:center;width:50px;height:50px;border-radius:50%;background:var(--purple);color:#fff;font-weight:800;font-size:1.1rem;flex:0 0 auto}.journey-sub{color:var(--muted);margin:0}
    .steps{display:grid;gap:14px}.step{display:grid;grid-template-columns:44px 1fr;gap:14px;padding:18px;border:1px solid var(--line);background:var(--soft)}.step-index{display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:#fff;border:1px solid var(--line);font-weight:800;color:var(--purple)}.step p:last-child{margin-bottom:0}
    .actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px}.button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 14px;border-radius:8px;background:var(--purple);border:1px solid var(--purple);color:#fff;text-decoration:none;font:inherit;font-weight:700;cursor:pointer}.button.secondary{background:#fff;color:var(--purple)}.button.danger{background:#fff;color:var(--red);border-color:#e7a5a0}.button:disabled{opacity:.55;cursor:not-allowed}
    .wallet-grid,.doc-grid,.function-grid,.info-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:16px}.card,.info-card{padding:18px;border:1px solid var(--line);background:#fff}.card h3,.info-card h3{margin-bottom:8px}.card p:last-child,.info-card p:last-child{margin-bottom:0}
    .principle{margin-top:18px;padding:18px;border-left:5px solid var(--green);background:var(--green-soft)}.warning{margin-top:18px;padding:18px;border-left:5px solid var(--gold);background:var(--gold-soft)}
    .flow{display:grid;grid-template-columns:repeat(9,minmax(110px,1fr));gap:10px;overflow-x:auto;padding:4px 0 10px;margin-top:18px}.flow-item{min-width:110px;padding:14px 10px;text-align:center;border:1px solid var(--line);background:#fff}
    .accordion{margin:0 0 20px;border:1px solid var(--line);background:#fff}.accordion summary{cursor:pointer;list-style:none;padding:18px 20px;font-size:1.08rem;font-weight:800;color:var(--text);background:var(--purple-soft)}.accordion summary::-webkit-details-marker{display:none}.accordion summary::after{content:"+";float:right;color:var(--purple);font-size:1.35rem;line-height:1}.accordion[open] summary::after{content:"–"}.accordion-body{padding:20px}.accordion-body>p:last-child{margin-bottom:0}.compact-sequence{counter-reset:item;margin:16px 0 0;padding:0;list-style:none;display:grid;gap:10px}.compact-sequence li{display:grid;grid-template-columns:34px 1fr;gap:12px;align-items:start;padding:14px;border:1px solid var(--line);background:var(--soft)}.compact-sequence li::before{counter-increment:item;content:counter(item);display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--purple-soft);color:var(--purple);font-weight:800}
    .toolbox{margin:20px 0;padding:20px;border:1px solid var(--line);background:var(--soft)}.toolbox h3{margin-bottom:6px}.field-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.field{display:grid;gap:7px}.field.full{grid-column:1/-1}.field label{font-weight:700}.field input,.field select,.field textarea{width:100%;min-height:46px;padding:10px 12px;border:1px solid #bfc5cc;border-radius:8px;background:#fff;color:var(--text);font:inherit}.field textarea{min-height:88px;resize:vertical}.field input:focus,.field select:focus,.field textarea:focus{outline:3px solid var(--purple-soft);border-color:var(--purple)}.helper{font-size:.9rem;color:var(--muted);margin:0}.status{min-height:24px;margin:10px 0 0;font-weight:700}.status.ok{color:var(--green)}.status.error{color:var(--red)}.selected-provider{margin-top:14px;padding:16px;border:1px solid var(--line);background:#fff}.selected-provider strong{display:block;margin-bottom:4px}.archive-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-end;margin-top:22px}.archive-count{font-weight:800;color:var(--purple)}.archive-list{display:grid;gap:10px;margin-top:14px}.archive-item{display:grid;grid-template-columns:1fr auto;gap:14px;align-items:center;padding:14px;border:1px solid var(--line);background:#fff}.archive-item.active{border-color:var(--purple);box-shadow:0 0 0 2px var(--purple-soft)}.archive-item strong{display:block}.archive-meta{font-size:.88rem;color:var(--muted);overflow-wrap:anywhere}.archive-empty{padding:16px;border:1px dashed #bfc5cc;background:#fff;color:var(--muted)}.file-input{display:none}.hidden{display:none!important}
    .pdf-link{font-weight:700;color:var(--purple);text-decoration:none}.pdf-link:hover{text-decoration:underline}.final{padding:26px;border-left:7px solid var(--green)}.final strong{color:var(--green)}footer{padding-top:18px;border-top:1px solid var(--line);color:var(--muted);font-size:.9rem}
    .toast{position:fixed;left:50%;top:50%;z-index:1000;transform:translate(-50%,-50%) scale(.96);max-width:min(90vw,520px)