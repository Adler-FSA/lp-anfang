ndChild(link);
        link.click();
        link.remove();
        URL.revokeObjectURL(url);
      };

      const csvEscape = (value) => `"${String(value ?? '').replace(/"/g, '""')}"`;

      document.getElementById('exportExchangeCsv').addEventListener('click', () => {
        const entries = readArchive();
        if (!entries.length) {
          setStatus(exchangeStatus, 'Das Affiliate-Archiv ist leer.', 'error');
          return;
        }
        const rows = [['Name', 'Kategorie', 'Affiliate-Link', 'Notiz'], ...entries.map(entry => [entry.name, entry.category, entry.url, entry.note])];
        const csv = '\uFEFF' + rows.map(row => row.map(csvEscape).join(';')).join('\r\n');
        downloadFile(`TLN-Affiliate-Archiv-${new Date().toISOString().slice(0, 10)}.csv`, csv, 'text/csv;charset=utf-8');
        showToast('CSV-Archiv wurde exportiert.');
      });

      document.getElementById('exportExchangeJson').addEventListener('click', () => {
        const backup = {version: 1, exportedAt: new Date().toISOString(), entries: readArchive()};
        downloadFile(`TLN-Affiliate-Sicherung-${new Date().toISOString().slice(0, 10)}.json`, JSON.stringify(backup, null, 2), 'application/json');
        showToast('Vollständige Sicherung wurde exportiert.');
      });

      const parseCsv = (text) => {
        const delimiter = text.includes(';') ? ';' : ',';
        const rows = [];
        let row = [], value = '', quoted = false;
        for (let i = 0; i < text.length; i += 1) {
          const char = text[i];
          if (char === '"') {
            if (quoted && text[i + 1] === '"') { value += '"'; i += 1; }
            else quoted = !quoted;
          } else if (char === delimiter && !quoted) {
            row.push(value); value = '';
          } else if ((char === '\n' || char === '\r') && !quoted) {
            if (char === '\r' && text[i + 1] === '\n') i += 1;
            row.push(value); value = '';
            if (row.some(cell => cell.trim())) rows.push(row);
            row = [];
          } else value += char;
        }
        row.push(value);
        if (row.some(cell => cell.trim())) rows.push(row);
        return rows;
      };

      const mergeEntries = (incoming) => {
        const entries = readArchive();
        let added = 0;
        incoming.map(sanitizeEntry).filter(Boolean).forEach(entry => {
          if (!entries.some(existing => existing.url === entry.url)) {
            entry.id = createId();
            entries.push(entry);
            added += 1;
          }
        });
        writeArchive(entries);
        renderArchive();
        return added;
      };

      document.getElementById('importExchangeCsv').addEventListener('click', () => csvFileInput.click());
      csvFileInput.addEventListener('change', async () => {
        const file = csvFileInput.files[0];
        if (!file) return;
        try {
          const rows = parseCsv((await file.text()).replace(/^﻿/, ''));
          const dataRows = rows.slice(rows[0] && /name/i.test(rows[0][0]) ? 1 : 0);
          const incoming = dataRows.map(row => ({name: row[0], category: row[1] || 'Börse', url: row[2], note: row[3] || ''}));
          const added = mergeEntries(incoming);
          setStatus(exchangeStatus, `${added} neue Affiliate-Einträge wurden aus der CSV übernommen.`, 'ok');
          showToast('CSV-Import wurde abgeschlossen.');
        } catch {
          setStatus(exchangeStatus, 'Die CSV-Datei konnte nicht verarbeitet werden.', 'error');
        } finally {
          csvFileInput.value = '';
        }
      });

      document.getElementById('importExchangeJson').addEventListener('click', () => jsonFileInput.click());
      jsonFileInput.addEventListener('change', async () => {
        const file = jsonFileInput.files[0];
        if (!file) return;
        try {
          const parsed = JSON.parse(await file.text());
          const incoming = Array.isArray(parsed) ? parsed : parsed.entries;
          if (!Array.isArray(incoming)) throw new Error('Ungültige Sicherung');
          const added = mergeEntries(incoming);
          setStatus(exchangeStatus, `${added} neue Affiliate-Einträge wurden aus der Sicherung übernommen.`, 'ok');
          showToast('Sicherung wurde importiert.');
        } catch {
          setStatus(exchangeStatus, 'Die Sicherungsdatei konnte nicht verarbeitet werden.', 'error');
        } finally {
          jsonFileInput.value = '';
        }
      });

      document.getElementById('deleteExchangeArchive').addEventListener('click', () => {
        if (!readArchive().length) return;
        if (!window.confirm('Soll das gesamte lokale Affiliate-Archiv wirklich gelöscht werden?')) return;
        localStorage.removeItem(EXCHANGE_ARCHIVE_KEY);
        resetEditor();
        renderArchive();
        setStatus(exchangeStatus, 'Das gesamte Affiliate-Archiv wurde gelöscht.', 'ok');
        showToast('Affiliate-Archiv wurde gelöscht.');
      });

      const migrateLegacyExchange = () => {
        if (readArchive().length) return;
        try {
          const legacy = JSON.parse(localStorage.getItem(LEGACY_EXCHANGE_KEY) || 'null');
          const entry = sanitizeEntry(legacy);
          if (entry) writeArchive([entry]);
        } catch {
          // Ungültige alte Auswahl wird ignoriert.
        }
      };

      const loadStoredData = () => {
        const affiliate = localStorage.getItem(AFFILIATE_KEY) || '';
        if (validAffiliateLink(affiliate)) affiliateInput.value = affiliate;
        updateAffiliateButtons();
        migrateLegacyExchange();
        renderArchive();
      };

      loadStoredData();
    })();
  </script>
</body>
</html>
